# Peticiones de ejemplo para la extensión REST Client de VS Code.
# Antes: `npm run dev` desde la raíz del repo.
# Uso: haz clic en "Send Request" sobre cada petición, en orden.

@baseUrl = http://localhost:3000/api
@email = ana@correo.cl
@password = secreta123

### Salud de la API y de las bases de datos
GET {{baseUrl}}/salud

### Registro (la segunda vez responde 409: cambia @email para crear otro usuario)
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{
  "nombre": "Ana",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Login: guarda la respuesta con el nombre "login" para reutilizar el token
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Perfil del usuario autenticado (usa el token del login; ejecuta primero el login)
GET {{baseUrl}}/auth/yo
Authorization: Bearer {{login.response.body.token}}

### Cerrar sesión (borra la cookie httpOnly que usa el navegador; con Bearer no tiene efecto)
POST {{baseUrl}}/auth/logout

### Login con contraseña incorrecta (espera 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "incorrecta"
}

### Registro inválido (espera 400 con el detalle por campo)
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{
  "nombre": "",
  "email": "no-es-email",
  "password": "123"
}

# ============================ Formularios ============================
# Todas requieren el token: ejecuta primero el login.

### Crear formulario (guarda la respuesta como "formulario")
# @name formulario
POST {{baseUrl}}/formularios
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "titulo": "Encuesta de café",
  "descripcion": "Queremos conocer tus gustos",
  "preguntas": [
    { "tipo": "texto_corto", "texto": "¿Cómo te llamas?", "obligatoria": true },
    { "tipo": "opcion_unica", "texto": "¿Cuál prefieres?", "opciones": ["Latte", "Espresso", "Capuccino"] },
    { "tipo": "opcion_multiple", "texto": "¿Qué acompañamientos te gustan?", "opciones": ["Azúcar", "Canela", "Leche"] },
    { "tipo": "escala", "texto": "¿Qué tan satisfecho estás?", "minimo": 1, "maximo": 5 },
    { "tipo": "fecha", "texto": "¿Cuándo fue tu última visita?" },
    { "tipo": "texto_largo", "texto": "Comentarios" }
  ]
}

### Listar mis formularios
GET {{baseUrl}}/formularios
Authorization: Bearer {{login.response.body.token}}

### Obtener el formulario creado
GET {{baseUrl}}/formularios/{{formulario.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

### Actualizar (reemplaza título, descripción y preguntas; el slug no cambia)
# "version" es OBLIGATORIA: la que estabas editando (viene en el GET). Si ya no es la vigente → 409.
# Si el formulario ya fue publicado y cambian las preguntas, se crea una versión nueva.
PUT {{baseUrl}}/formularios/{{formulario.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "titulo": "Encuesta de café (v2)",
  "version": 1,
  "preguntas": [
    { "tipo": "escala", "texto": "Del 1 al 5, ¿nos recomendarías?", "obligatoria": true }
  ]
}

### Regla de negocio incumplida (espera 400: una sola opción)
POST {{baseUrl}}/formularios
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "titulo": "Inválido",
  "preguntas": [{ "tipo": "opcion_unica", "texto": "¿Sí?", "opciones": ["Sí"] }]
}

# ======================= Publicar y responder =======================

### Publicar (requiere al menos 1 pregunta; desde borrador o cerrado)
POST {{baseUrl}}/formularios/{{formulario.response.body.id}}/publicar
Authorization: Bearer {{login.response.body.token}}

### Ver el formulario público (SIN token: así lo ve quien responde)
GET {{baseUrl}}/publico/{{formulario.response.body.slug}}

### Responder (SIN token). Claves = id de cada pregunta: cópialos del GET anterior.
# "version" (opcional) = la que viste en el GET; si el formulario cambió después, se valida contra esa.
# Máximo 60 envíos por IP cada 15 minutos por defecto (LIMITE_RESPUESTAS_* en .env); luego responde 429.
POST {{baseUrl}}/publico/{{formulario.response.body.slug}}/respuestas
Content-Type: application/json

{
  "version": 1,
  "respuestas": {
    "REEMPLAZA-ID-PREGUNTA-1": "Ana",
    "REEMPLAZA-ID-PREGUNTA-2": "Latte"
  }
}

# ======================== Equipos y compartir ========================
# Para probar roles, registra un segundo usuario (cambia @email arriba) y agrégalo por email.

### Crear equipo (quien lo crea queda como propietario)
# @name equipo
POST {{baseUrl}}/equipos
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "nombre": "Marketing" }

### Mis equipos (con mi rol y cantidad de miembros)
GET {{baseUrl}}/equipos
Authorization: Bearer {{login.response.body.token}}

### Detalle del equipo con sus miembros
GET {{baseUrl}}/equipos/{{equipo.response.body.id}}
Authorization: Bearer {{login.response.body.token}}

### Agregar miembro por email (rol: propietario | editor | lector). 404 si el email no está registrado
POST {{baseUrl}}/equipos/{{equipo.response.body.id}}/miembros
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "email": "beto@correo.cl", "rol": "editor" }

### Cambiar el rol de un miembro (reemplaza 2 por su usuarioId)
PATCH {{baseUrl}}/equipos/{{equipo.response.body.id}}/miembros/2
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "rol": "lector" }

### Quitar a un miembro (o salir del equipo con tu propio id). 409 si eres el último propietario
DELETE {{baseUrl}}/equipos/{{equipo.response.body.id}}/miembros/2
Authorization: Bearer {{login.response.body.token}}

### Compartir el formulario con el equipo (solo su propietario)
POST {{baseUrl}}/formularios/{{formulario.response.body.id}}/compartir
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "equipoId": {{equipo.response.body.id}} }

### Dejar de compartir
POST {{baseUrl}}/formularios/{{formulario.response.body.id}}/compartir
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{ "equipoId": null }

# ============================ Resultados ============================

### Estadísticas combinando todas las versiones (zona por defecto: America/Santiago)
GET {{baseUrl}}/formularios/{{formulario.response.body.id}}/resultados
Authorization: Bearer {{login.response.body.token}}

### Estadísticas de una sola versión y agrupando días en UTC
GET {{baseUrl}}/formularios/{{formulario.response.body.id}}/resultados?version=1&zona=UTC
Authorization: Bearer {{login.response.body.token}}

### Listado paginado de respuestas (más recientes primero; tamano máx. 100)
GET {{baseUrl}}/formularios/{{formulario.response.body.id}}/respuestas?pagina=1&tamano=20
Authorization: Bearer {{login.response.body.token}}

### Cerrar (después, el link público responde 410)
POST {{baseUrl}}/formularios/{{formulario.response.body.id}}/cerrar
Authorization: Bearer {{login.response.body.token}}

### Eliminar (espera 204; borra también sus respuestas)
DELETE {{baseUrl}}/formularios/{{formulario.response.body.id}}
Authorization: Bearer {{login.response.body.token}}
