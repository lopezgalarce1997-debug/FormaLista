# Copia este archivo como .env (en esta misma carpeta /api) y completa los valores.
# .env NO se sube al repositorio.

NODE_ENV=development
PORT=3000

# MySQL local. Usa un usuario dedicado para la app, no root.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=formalista
MYSQL_PASSWORD=
MYSQL_DATABASE=formalista

# Base para las pruebas de integración (npm run test:integracion). Se TRUNCA en cada prueba:
# por seguridad debe terminar en "_pruebas". Mismo usuario y contraseña de arriba.
MYSQL_DATABASE_PRUEBAS=formalista_pruebas

# MongoDB local (sin autenticación en desarrollo)
MONGODB_URI=mongodb://localhost:27017/formalista

# JWT: usa un valor largo y aleatorio. Por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Origen permitido para CORS (el frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# Límite de respuestas públicas por IP (varias personas pueden compartir IP: ver README)
LIMITE_RESPUESTAS_MAXIMO=60
LIMITE_RESPUESTAS_VENTANA_MINUTOS=15
