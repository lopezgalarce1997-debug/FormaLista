{
  "name": "formalista",
  "private": true,
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "dev:web:red": "npm run dev -w web -- --host",
    "build": "npm run build -w @formalista/compartido && npm run build -w api && npm run build -w web",
    "test": "npm test --workspaces --if-present",
    "test:integracion": "npm run test:integracion -w api",
    "migrar": "npm run migrar -w api",
    "limpiar-huerfanos": "npm run limpiar-huerfanos -w api"
  },
  "engines": {
    "node": ">=22"
  }
}
